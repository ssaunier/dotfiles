# Get External IP / local IPs
alias ip="curl ipinfo.io/ip"
alias ips="ifconfig -a | perl -nle'/(\d+\.\d+\.\d+\.\d+)/ && print $1'"

# Quickly serve the current directory as HTTP
alias serve='python3 -m http.server'  # Or python -m SimpleHTTPServer :)

# Connectivity
alias wtf='ping 8.8.8.8'
alias dns='networksetup -setdnsservers Ethernet 1.1.1.1; networksetup -setdnsservers Wi-Fi 1.1.1.1'
alias dns_reset='networksetup -setdnsservers Ethernet empty; networksetup -setdnsservers Wi-Fi empty'

# Sublime Merge
alias smerge="/Applications/Sublime\ Merge.app/Contents/SharedSupport/bin/smerge ."
