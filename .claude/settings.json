{
  "permissions": {
    "additionalDirectories": [
      "/home/coder/.claude"
    ]
  },
  "skillOverrides": {
    "chdb-datastore": "off",
    "clickhouse-js-node-coding": "off",
    "clickhouse-js-node-rowbinary": "off",
    "clickhouse-js-node-troubleshooting": "off",
    "clickhouse-managed-postgres-rca": "off",
    "clickstack-otel-collector": "off",
    "infra-clickhouse": "off",
    "infra-postgres": "off",
    "plugin-authoring": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "chdb-sql": "name-only",
    "clickhouse-architecture-advisor": "name-only",
    "grilling": "name-only",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "keybindings-help": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:deep-research": "name-only",
    "anthropic-skills:skill-creator": "name-only"
  },
  "model": "opus",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark-ansi",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size 2>/dev/null </dev/tty | awk '\"'\"'{print $2}'\"'\"');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/usr/bin/node\" \"${plugin_dir}dist/index.js\"'",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "autoUpdatesChannel": "latest"
}
